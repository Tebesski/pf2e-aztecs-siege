{
   "id": "pf2e-aztecs-siege",
   "title": "PF2e Aztec's Engines of War",
   "version": "#{VERSION}#",
   "compatibility": {
      "minimum": "14",
      "verified": "14"
   },
   "authors": [{ "name": "Aztec" }],
   "esmodules": ["scripts/main.mjs"],
   "styles": [
      "styles/core.css",
      "styles/sheet.css",
      "styles/action-ammo.css",
      "styles/crew-hud.css",
      "styles/crew-dossier.css",
      "styles/vehicle-hud.css",
      "styles/vehicle-combat.css",
      "styles/sfx.css",
      "styles/vehicle-stash.css",
      "styles/modules.css",
      "styles/consequence-cards.css"
   ],
   "languages": [
      { "lang": "en", "name": "English", "path": "lang/en.json" },
      { "lang": "ru", "name": "Русский", "path": "lang/ru.json" }
   ],
   "relationships": {
      "requires": [{ "id": "socketlib", "type": "module" }]
   },
   "socket": true,
   "url": "#{URL}#",
   "manifest": "#{MANIFEST}#",
   "download": "#{DOWNLOAD}#",
   "packs": [
      {
         "name": "engines-of-war",
         "label": "Engines of War",
         "path": "packs/engines-of-war",
         "type": "Macro",
         "system": "pf2e",
         "private": false,
         "ownership": {
            "PLAYER": "OBSERVER",
            "ASSISTANT": "OWNER"
         }
      }
   ]
}
