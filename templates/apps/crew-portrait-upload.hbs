<div class="siege-crew-portrait scp-upload-only">
   <div class="scp-row">
      <button class="scp-pick" data-tooltip="{{labels.pickImage}}"><i class="fa-solid fa-file-image"></i></button>
      <input type="text" class="scp-path" value="{{foregroundSrc}}" readonly>
   </div>
   <div class="scp-upload-preview" style="{{uploadPreviewStyle}}"></div>
   <div class="scp-buttons">
      <button class="scp-save"><i class="fa-solid fa-check"></i> {{labels.save}}</button>
   </div>
</div>
