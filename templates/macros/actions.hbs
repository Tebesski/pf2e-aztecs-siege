{{#if showLeaveVehicle}}
<hr class="siege-sep">
<button class="roll-siege-btn siege-exit-vehicle-btn" data-type="{{leaveVehicleType}}">
   <i class="fa-solid {{leaveVehicleIcon}}"></i> {{leaveVehicleLabel}}
</button>
{{/if}}
