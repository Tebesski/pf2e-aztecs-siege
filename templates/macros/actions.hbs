<button class="roll-siege-btn siege-top-btn" data-type="repair">
   <i class="fa-solid fa-hammer"></i> {{i18n.repair}}: {{siegeName}} (DC {{repairDC}})
</button>
{{#if isLifting}}
<button class="roll-siege-btn siege-top-btn siege-top-btn-extra" data-type="delegate-weight">
   <i class="fa-solid fa-people-arrows"></i> {{i18n.delegateWeight}} ({{myLiftBulk}})
</button>
{{/if}}
<hr class="siege-sep">

{{#if crewBlocked}}
<div class="siege-banner siege-banner-error">
   <i class="fa-solid fa-triangle-exclamation"></i> {{i18n.noCrew}} ({{totalMissing}})
</div>
{{else if shorthandedPenalty}}
<div class="siege-banner siege-banner-warn">
   <i class="fa-solid fa-person-falling"></i> {{i18n.shorthandedActive}} ({{shorthandedPenalty}}): {{missingCrewString}}
</div>
{{/if}}

<div class="siege-actions-accordion">
   {{#each actions}}
   <details>
      <summary>
         <div class="action-name">
            <img src="{{this.img}}" class="action-icon" />
            <span>{{this.name}}</span>
            {{{this.costGlyph}}}
         </div>
         <i class="fa-solid fa-chevron-right chevron"></i>
      </summary>
      <div class="details-body">
         <div class="details-desc">{{{this.description}}}</div>

         {{#if this.prereqData.length}}
         <div class="siege-info-box">
            <p class="siege-no-margin"><strong>{{../i18n.prerequisites}}:</strong>
               {{#each this.prereqData}}
                  <span class="siege-prereq-item">{{this.name}} {{#if this.showCount}}{{this.current}} / {{this.required}} {{/if}}{{#if this.fulfilled}}<i class="fa-solid fa-check siege-icon-ok"></i>{{else}}<i class="fa-solid fa-times siege-icon-bad"></i>{{/if}}</span>
               {{/each}}
            </p>
         </div>
         {{/if}}

         {{#if this.isStrike}}
         <div class="siege-action-details siege-info-box">
            {{#if this.ammoName}}
            <p class="siege-detail-line"><strong>{{../i18n.ammunition}}:</strong> {{this.ammoName}} ({{this.spend}})</p>
            <p class="siege-detail-line"><strong>{{this.ammoLoaded}} / {{this.ammoMax}}</strong></p>
            {{/if}}
            <p class="siege-detail-line"><strong>{{../i18n.traits}}:</strong> {{this.traitsStr}}</p>

            {{#if this.isAbility}}
               <p class="siege-detail-line"><strong>{{../i18n.saveDC}}:</strong> {{this.saveDC}}</p>
               {{#if this.areaSize}}
               <p class="siege-no-margin"><strong>{{../i18n.area}}:</strong> {{this.areaSize}} ft. {{capitalize this.areaType}}</p>
               {{/if}}
            {{else if this.isRanged}}
               <p class="siege-no-margin"><strong>{{../i18n.range}}:</strong> {{this.blindRange}} / {{this.minRange}} / {{this.maxRange}}</p>
            {{/if}}
         </div>

         <div class="siege-damage-tags">
            {{{this.damageHtml}}}
         </div>
         {{/if}}

         <div class="details-buttons">
            {{#each this.buttons}}
            <button class="roll-siege-btn" data-type="{{this.type}}" data-item="{{../id}}" {{#if this.hasIdx}}data-skillidx="{{this.idx}}"{{/if}} {{#if ../../crewBlocked}}disabled{{/if}}>
               <img src="{{../img}}" class="action-icon"> {{{this.label}}} {{{../costGlyph}}}
            </button>
            {{/each}}
         </div>

         {{#if this.isStrike}}
         <div class="vehicle-penalties">
            {{#if this.cornerShot}}
            <label class="siege-inline-checkbox-tight">
               <input type="checkbox" class="siege-corner-shot-cb" data-item="{{this.id}}"> {{../i18n.cornerShot}} ({{this.cornerShot.newSize}}-ft {{capitalize this.cornerShot.newType}})
            </label>
            {{/if}}
            <div class="siege-penalty-row">
               <label class="siege-inline-checkbox-tight">
                  <input type="checkbox" class="veh-penalty-2" data-item="{{this.id}}"> {{../i18n.penalty2}}
               </label>
               <label class="siege-inline-checkbox-tight">
                  <input type="checkbox" class="veh-penalty-4" data-item="{{this.id}}"> {{../i18n.penalty4}}
               </label>
            </div>

            {{#if this.hasNonlethal}}
            <div class="siege-penalty-row">
               <label class="siege-inline-checkbox-tight">
                  <input type="checkbox" class="siege-nonlethal-cb" data-item="{{this.id}}" checked> {{../i18n.lethalAttack}}
               </label>
            </div>
            {{/if}}

            {{#if ../isPortable}}
               {{#if this.isStrike}}
               <div class="siege-penalty-row">
                  <label class="siege-inline-checkbox-tight">
                     <input type="checkbox" class="siege-highest-str-cb" data-item="{{this.id}}" checked> {{../i18n.highestStrInCrew}}
                  </label>
               </div>
               {{/if}}
            {{/if}}

            {{#if this.versatileOptions.length}}
            <div class="siege-penalty-row siege-versatile-row">
               <label class="siege-inline-checkbox-tight">
                  <input type="radio" name="versatile-{{this.id}}" class="siege-versatile-radio" data-item="{{this.id}}" value="base" checked> {{../i18n.damage}}
               </label>
               {{#each this.versatileOptions}}
               <label class="siege-inline-checkbox-tight">
                  <input type="radio" name="versatile-{{../id}}" class="siege-versatile-radio" data-item="{{../id}}" data-type="{{this.type}}" value="{{this.trait}}"> {{this.label}}
               </label>
               {{/each}}
            </div>
            {{/if}}
         </div>
         {{/if}}
      </div>
   </details>
   {{/each}}
</div>
