<header class="char-header">
   <div class="char-details">
      <h1 class="char-name">
         <input
            name="name"
            type="text"
            value="{{document.name}}"
            placeholder="{{localize "PF2E-AZTECS-SIEGE.Sheet.CharacterName"}}"
         />
      </h1>
      <div class="tags">
         <select
            class="rarity rarity-select {{system.traits.rarity}}"
            name="system.traits.rarity"
         >
            {{selectOptions rarities selected=system.traits.rarity}}
         </select>
         <select class="size size-select" name="system.traits.size.value">
            {{selectOptions sizes selected=system.traits.size.value}}
         </select>
      </div>
   </div>
   <div class="char-level">
      <div class="level">
         <label>{{localize "PF2E-AZTECS-SIEGE.Actor.SiegeWeapon"}}</label>
         <input
            name="system.details.level.value"
            type="number"
            value="{{system.details.level.value}}"
            placeholder="1"
            size="2"
         />
      </div>
   </div>
</header>
