<section class="sheet-body">
   <section class="sheet-content">

      <div class="tab details active" data-tab="details">
         <div class="details-content">
            <div class="bio-item trait-size">
               <section class="vehicle-details">
                  <div class="frame image-container">
                     <img class="actor-image" src="{{document.img}}" title="{{document.name}}" data-edit="img" />
                     <a class="hover-icon" data-action="showImage"><i class="fa-solid fa-image fa-fw"></i></a>
                  </div>
                  <div class="detail-sheet">
                     <div class="detail-small row-nr-1 span-2-columns">
                        <div class="inputSplit siege-dimensions-field">
                           <label class="details-label siege-dimensions-label">
                              {{localize "PF2E-AZTECS-SIEGE.Attributes.Dimensions"}}
                              <i class="fa-solid fa-circle-info siege-info-icon" data-tooltip="{{localize "PF2E-AZTECS-SIEGE.Sheet.DimensionsTooltip"}}" data-tooltip-direction="UP"></i>
                           </label>
                           <div class="details-input siege-dimensions-control" role="group" aria-label="{{localize "PF2E-AZTECS-SIEGE.Attributes.Dimensions"}}">
                              <input class="siege-dimension-part" data-dimension="long" type="text" inputmode="decimal" value="{{system.details.space.long}}" aria-label="{{localize "PF2E-AZTECS-SIEGE.Attributes.Length"}}" />
                              <span class="siege-dimensions-separator" aria-hidden="true">/</span>
                              <input class="siege-dimension-part" data-dimension="wide" type="text" inputmode="decimal" value="{{system.details.space.wide}}" aria-label="{{localize "PF2E-AZTECS-SIEGE.Attributes.Width"}}" />
                              <span class="siege-dimensions-separator" aria-hidden="true">/</span>
                              <input class="siege-dimension-part" data-dimension="high" type="text" inputmode="decimal" value="{{system.details.space.high}}" aria-label="{{localize "PF2E-AZTECS-SIEGE.Attributes.Height"}}" />
                           </div>
                        </div>
                        <div class="inputSplit">
                           <label class="details-label">{{localize "PF2E-AZTECS-SIEGE.Attributes.Price"}}</label>
                           <input class="details-input" name="system.details.price" type="number" value="{{system.details.price}}" />
                        </div>
                     </div>
                     <div class="row-nr-2 span-2-columns">
                        <label class="details-label">{{localize "PF2E-AZTECS-SIEGE.Attributes.Speed"}}</label>
                        <input class="details-input" name="system.details.speed" type="text" value="{{system.details.speed}}" />
                     </div>
                  </div>
               </section>

               <section class="vehicle-properties">
                  <div class="detailsInput flexitem-full">
                     <span class="details-label">{{localize "PF2E-AZTECS-SIEGE.Attributes.Traits"}}</span>
                     <ul class="tags">
                        {{#each actorTraits as |trait|}}
                           <li class="tag tag_secondary" data-trait="{{trait.value}}">{{trait.label}}</li>
                        {{/each}}
                        <li class="tag tag_secondary edit-btn">
                           <a class="tag-selector" data-tag-selector="basic" data-config-types="vehicleTraits" data-property="system.traits">
                              <i class="fa-solid fa-plus"></i>
                           </a>
                        </li>
                     </ul>
                  </div>
               </section>
            </div>
         </div>
      </div>

      <div class="tab actions" data-tab="actions"></div>
      <div class="tab ammunition" data-tab="ammunition"></div>
      <div class="tab crew" data-tab="crew"></div>
      <div class="tab sfx" data-tab="sfx"></div>
      <div class="tab description" data-tab="description">
         {{editor system.details.description target="system.details.description" button=true editable=true engine="prosemirror"}}
      </div>

   </section>
</section>
