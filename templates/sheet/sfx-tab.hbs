<h3>{{globalHeader}}</h3>
{{#each sections}}
   <div class="sfx-acc" data-section="{{this.id}}">
      <button type="button" class="sfx-acc-head">
         <i class="fa-solid fa-chevron-right sfx-acc-caret"></i>
         {{this.title}}
      </button>
      <div class="sfx-acc-body" style="display:none;">
         {{#each this.intervals}}
         <div class="form-group sfx-interval-row">
            <label>{{this.label}}</label>
            <input type="number" class="{{this.className}}" value="{{this.value}}" min="{{this.min}}" />
         </div>
         {{/each}}
         {{#each this.rows}}
         <div class="form-group sfx-row" data-key="{{this.key}}">
            <label>{{this.label}}</label>
            <input type="text" value="{{this.value}}" class="sfx-input" data-key="{{this.key}}" />
            <button type="button" class="play-sfx" data-key="{{this.key}}"><i class="fa-solid fa-play"></i></button>
            <button type="button" class="file-picker" data-type="audio" data-target="{{this.key}}"><i class="fa-solid fa-file-audio"></i></button>
            <div class="sfx-option-row">
               <label class="sfx-timing-choice">
                  <input type="checkbox" class="sfx-global-cb" data-key="{{this.key}}" {{#if this.global}}checked{{/if}}>
                  {{this.globalLabel}}
               </label>
            </div>
         </div>
         {{/each}}
         {{#unless this.rows.length}}
         <p class="sfx-empty">—</p>
         {{/unless}}
      </div>
   </div>
{{/each}}
